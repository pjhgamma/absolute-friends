<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <DefineConstants Condition="'$(RecordBaseline)' == 'true'">$(DefineConstants);RIPPLEFRIENDS_RECORDBASELINE</DefineConstants>
    <ModOutputPath>..\release\</ModOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="..\lib\PUBLIC-Assembly-CSharp.dll" Private="false" />
    <Reference Include="..\lib\HOOKS-Assembly-CSharp.dll" Private="false" />
    <Reference Include="..\lib\BepInEx.dll" Private="false" />
    <Reference Include="..\lib\Mono.Cecil.dll" Private="false" />
    <Reference Include="..\lib\MonoMod.Utils.dll" Private="false" />
    <Reference Include="..\lib\UnityEngine.dll" Private="false" />
    <Reference Include="..\lib\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="..\lib\UnityEngine.IMGUIModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build">
    <ItemGroup>
      <PluginFiles Include="$(TargetPath)" />
      <AssetFiles Include="..\assets\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(ModOutputPath)plugins" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(AssetFiles)" DestinationFiles="$(ModOutputPath)%(RecursiveDir)%(Filename)%(Extension)" SkipUnchangedFiles="true" />
  </Target>

</Project>
